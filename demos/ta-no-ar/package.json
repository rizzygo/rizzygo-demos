{
  "name": "ta-no-ar",
  "private": true,
  "description": "Página de status com Cron Trigger, Workers e D1, no plano Free da Cloudflare.",
  "scripts": {
    "banco": "wrangler d1 execute ta-no-ar --local --file=schema.sql",
    "exemplo": "wrangler d1 execute ta-no-ar --local --file=exemplo.sql",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "conferir": "wrangler deploy --dry-run --outdir=.wrangler/conferir"
  },
  "devDependencies": {
    "wrangler": "4.161.0"
  }
}
