// Configuração do Worker. Troque o database_id pelo que o wrangler mostrar ao criar o D1 (veja o README).
{
  "name": "ta-no-ar",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "dev": { "port": 8788 },
  "assets": { "directory": "./public" },
  "d1_databases": [{ "binding": "DB", "database_name": "ta-no-ar", "database_id": "troque-pelo-id-do-d1" }],
  // A cada 5 minutos. O plano Free permite 5 Cron Triggers por conta.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Os sites que a página acompanha. Troque pelos seus.
    "SITES": "[\"https://rizzygo.com.br\", \"https://ako.rizzygo.com.br\", \"https://example.com\"]"
  }
}
